# SpeakASAP Platform Environment Variables
# Port Range: 42xx (4200-4219)
# Copy this file to speakasap/.env (repo root only). Do not maintain per-service .env copies.

# ============================================
# Port Configuration (42xx Range)
# ============================================
# Certification/assessment keys below: when unset, docker-compose.blue.yml / docker-compose.green.yml substitute defaults (4202/4203, service names, DB names, DATABASE_URL host db-server-postgres — password still required in real .env).
# Service Ports
CONTENT_SERVICE_PORT=
CONTENT_SERVICE_PORT_GREEN=
CERTIFICATION_SERVICE_PORT=
ASSESSMENT_SERVICE_PORT=
USER_SERVICE_PORT=
# Host port for green user-service (container still listens on USER_SERVICE_PORT); must differ from blue host bind
USER_SERVICE_PORT_GREEN=
CERTIFICATION_SERVICE_NAME=
ASSESSMENT_SERVICE_NAME=
USER_SERVICE_NAME=
USER_DB_NAME=
CERTIFICATION_DATABASE_URL=
ASSESSMENT_DATABASE_URL=
USER_DATABASE_URL=
COURSE_SERVICE_PORT=
COURSE_SERVICE_PORT_GREEN=
COURSE_SERVICE_NAME=
COURSE_DB_NAME=
COURSE_DATABASE_URL=
COURSE_SOURCE_DATABASE_URL=
COURSE_TARGET_DATABASE_URL=
EDUCATION_SERVICE_PORT=
EDUCATION_SERVICE_PORT_GREEN=
EDUCATION_SERVICE_NAME=
EDUCATION_DB_NAME=
EDUCATION_DATABASE_URL=
EDUCATION_SOURCE_DATABASE_URL=
EDUCATION_TARGET_DATABASE_URL=
PAYMENT_SERVICE_PORT=
NOTIFICATION_SERVICE_PORT=
API_GATEWAY_PORT=
FRONTEND_PORT=
SALARY_SERVICE_PORT=
FINANCIAL_SERVICE_PORT=

# Reserved for future speakasap services: 4200, 4204, 4216-4219 (4214-4215: standalone marathon/)

# ============================================
# Database Configuration (Shared database-server)
# ============================================
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=

# Database Names (one per service)
DB_NAME=
DATABASE_URL=
# Also configure for:
# - speakasap_certification_db
# - speakasap_assessment_db
# - speakasap_course_db
# - speakasap_education_db
# - speakasap_user_db
# - speakasap_payment_db
# - speakasap_notification_db
# - speakasap_salary_db
# - speakasap_financial_db

# ============================================
# Shared Microservices Configuration
# ============================================
# Auth Microservice
AUTH_SERVICE_URL=
AUTH_MICROSERVICE_PORT=

# Logging Microservice
LOGGING_SERVICE_URL=
LOGGING_SERVICE_API_PATH=
LOGGING_MICROSERVICE_PORT=

# Notifications Microservice
NOTIFICATION_SERVICE_URL=
NOTIFICATIONS_MICROSERVICE_URL=
NOTIFICATIONS_MICROSERVICE_PORT=

# Payments Microservice
PAYMENTS_MICROSERVICE_URL=
PAYMENTS_MICROSERVICE_PORT=

# AI Microservice
AI_SERVICE_URL=
AI_MICROSERVICE_PORT=
AI_SERVICE_TIMEOUT=
AI_SERVICE_API_KEY=
AI_SERVICE_TRANSLATE_PATH=

# ============================================
# Application Configuration
# ============================================
SERVICE_NAME=
PORT=
NODE_ENV=
DOMAIN=
NGINX_NETWORK_NAME=
HTTP_TIMEOUT=
GATEWAY_TIMEOUT=
AUTH_SERVICE_TIMEOUT=
NOTIFICATION_SERVICE_TIMEOUT=
LOGGING_SERVICE_TIMEOUT=
RETRY_MAX_ATTEMPTS=
RETRY_DELAY_MS=
AUTH_RETRY_MAX_ATTEMPTS=
AUTH_RETRY_DELAY_MS=
NOTIFICATION_RETRY_MAX_ATTEMPTS=
NOTIFICATION_RETRY_DELAY_MS=
CORS_ORIGIN=
FRONTEND_URL=

# ============================================
# Prisma / Redis (optional; marathon-style services)
# ============================================
PRISMA_SCHEMA_ENGINE_BINARY=
PRISMA_QUERY_ENGINE_BINARY=
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
REDIS_DB=

# ============================================
# Logging (app-level)
# ============================================
LOG_LEVEL=
LOG_TIMESTAMP_FORMAT=

# ============================================
# Content-oriented defaults (when using content-style services)
# ============================================
DEFAULT_PAGE_SIZE=
MAX_PAGE_SIZE=
ASSETS_BASE_URL=

# Frontend Configuration
NEXT_PUBLIC_API_URL=

# ============================================
# Monorepo SSOT (single file: copy to ./.env at repo root only)
# ============================================
# Per-service `*/.env` copies under speakasap/ are not used; templates live only here.
# Docker Compose uses `env_file: ../.env` from service dirs or root compose.
# Prisma CLI: use `npm run prisma:validate` (loads ../.env and the right DATABASE_URL alias).

# --- Content service (Phase 1) extras ---

# --- Certification service (Phase 2) ---
JWT_SECRET=
CERT_VIEW_TOKEN_SECRET=
MATERIALS_PUBLIC_BASE_URL=
INTERNAL_API_KEY=
SOURCE_DATABASE_URL=
TARGET_DATABASE_URL=
CERTIFICATION_SOURCE_DATABASE_URL=
CERTIFICATION_TARGET_DATABASE_URL=
ASSESSMENT_SOURCE_DATABASE_URL=
ASSESSMENT_TARGET_DATABASE_URL=

# --- Assessment service (Phase 2) ---
LANGUAGE_TEST_LANDING_BASE_URL=
ASSESSMENT_SERVICE_PUBLIC_BASE_URL=
ASSESSMENT_VIEW_TOKEN_SECRET=
# Docker: set to /app/assets (assessment-service Dockerfile copies ./assets there)
# In Docker, defaults to /app/assets (see docker-compose.*.yml) if unset.
USER_TEST_ASSETS_DIR=

# --- User service (Phase 3) ---
INTERNAL_API_TOKEN=

# --- User ETL (migrate-user-from-legacy.py); optional operator-only ---
# On alfares host: set TARGET_DATABASE_URL and AUTH_DATABASE_URL with 127.0.0.1:5432 (not db-server-postgres) so Python reaches Postgres. SOURCE_* matches CERTIFICATION_SOURCE_* (tunnel 127.0.0.1:15432). Services keep USER_DATABASE_URL with db-server-postgres.
AUTH_DATABASE_URL=

# --- course-materials-service (sibling folder; compose --env-file ../.env) ---

CERTIFICATION_SERVICE_DOMAIN=
ASSESSMENT_SERVICE_DOMAIN=
