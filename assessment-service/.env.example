# ============================================
# Application (single source of truth)
# ============================================
NODE_ENV=
DOMAIN=
SERVICE_NAME=
PORT=

# ============================================
# Database (Phase 2 target: speakasap_assessment_db)
# ============================================
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
DATABASE_URL=
# ETL (TASK-27): TARGET mirrors DATABASE_URL. SOURCE = read-only legacy portal Postgres (credentials in real .env only).
# Legacy on speakasap: Postgres 127.0.0.1:5432; from other hosts tunnel (e.g. local port 15432) then SOURCE …@127.0.0.1:15432/portal_db
TARGET_DATABASE_URL=
SOURCE_DATABASE_URL=

# ============================================
# Auth microservice (JWT validation)
# ============================================
AUTH_SERVICE_URL=
AUTH_SERVICE_TIMEOUT=

# ============================================
# Staff / manager RBAC (comma-separated role names from auth validate)
# ============================================
ASSESSMENT_STAFF_ROLE_NAMES=
ASSESSMENT_MANAGER_ROLE_NAMES=

# ============================================
# Public URLs (language test entry + result signing)
# ============================================
LANGUAGE_TEST_LANDING_BASE_URL=
ASSESSMENT_SERVICE_PUBLIC_BASE_URL=
ASSESSMENT_VIEW_TOKEN_SECRET=

# ============================================
# Asset quiz JSON templates (legacy user_tests/assets)
# ============================================
USER_TEST_ASSETS_DIR=

# ============================================
# Logging microservice
# ============================================
LOGGING_SERVICE_URL=
LOGGING_SERVICE_API_PATH=
LOGGING_SERVICE_TIMEOUT=

# ============================================
# Optional
# ============================================
LOG_LEVEL=
# If you use a format with spaces, quote the whole value so `set -a && . ./.env` works, e.g.:
# LOG_TIMESTAMP_FORMAT="YYYY-MM-DD HH:mm:ss"
LOG_TIMESTAMP_FORMAT=
NGINX_NETWORK_NAME=
