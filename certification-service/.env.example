# ============================================
# Application (single source of truth)
# ============================================
NODE_ENV=
DOMAIN=
SERVICE_NAME=
PORT=

# ============================================
# Database (Phase 2 target: speakasap_certification_db)
# ============================================
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
DATABASE_URL=
# ETL (TASK-24): TARGET mirrors DATABASE_URL; SOURCE = read-only legacy portal Postgres (no secret in example).
TARGET_DATABASE_URL=
SOURCE_DATABASE_URL=

# ============================================
# Pagination (limit capped at MAX_PAGE_SIZE, max 30)
# ============================================
DEFAULT_PAGE_SIZE=
MAX_PAGE_SIZE=

# ============================================
# Auth (same JWT_SECRET as auth-microservice for access tokens)
# ============================================
JWT_SECRET=

# ============================================
# Public certificate view links (HMAC/JWT for signedViewToken payloads)
# ============================================
CERT_VIEW_TOKEN_SECRET=

# ============================================
# Materials / certificates asset URLs (no trailing slash required)
# ============================================
MATERIALS_PUBLIC_BASE_URL=

# ============================================
# Internal S2S / admin-style routes (POST .../internal/...)
# ============================================
INTERNAL_API_KEY=

# ============================================
# Logging microservice
# ============================================
LOGGING_SERVICE_URL=
LOGGING_SERVICE_API_PATH=
LOGGING_SERVICE_TIMEOUT=

# ============================================
# Optional
# ============================================
LOG_LEVEL=
# Quote if the format contains spaces (bash `source .env`).
LOG_TIMESTAMP_FORMAT=
NGINX_NETWORK_NAME=

TARGET_DATABASE_URL=
SOURCE_DATABASE_URL=
