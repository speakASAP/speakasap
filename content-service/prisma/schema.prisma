generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Language {
  id          Int      @id @default(autoincrement())
  code        String   @db.VarChar(2) @unique
  machineName String   @db.VarChar(255)
  name        String   @db.VarChar(255)
  iconPath    String   @db.VarChar(255)
  order       Int      @default(0)
  speaker     String   @db.VarChar(255) @default("носитель")

  grammarCourse   GrammarCourse?
  phoneticsCourse PhoneticsCourse?
  songsCourse     SongsCourse?
  sevenCourses    SevenCourse[]
  words           Word[]
  drillTopics     DrillTopic[]
  drillItems      DrillItem[]
  courseVocabulary CourseVocabulary[]
  drillSets       DrillSet[]

  @@index([order])
  @@index([name])

  @@map("language")
}

model GrammarCourse {
  id              Int     @id @default(autoincrement())
  title           String  @db.VarChar(255)
  materialLanguage String @db.VarChar(2) @default("ru")
  metaKeywords    String? @db.Text
  metaDescription String? @db.Text
  languageId      Int     @unique
  language        Language @relation(fields: [languageId], references: [id])
  lessons         GrammarLesson[]

  @@map("grammar_course")
}

model GrammarLesson {
  id              Int     @id @default(autoincrement())
  title           String  @db.VarChar(512)
  courseId        Int
  template        String  @db.VarChar(255)
  alias           String? @db.VarChar(255)
  url             String  @db.VarChar(255)
  section         String? @db.VarChar(255)
  teaser          String? @db.Text
  order           Int     @default(0)
  metaKeywords    String? @db.Text
  metaDescription String? @db.Text

  course GrammarCourse @relation(fields: [courseId], references: [id])

  @@index([courseId, order])

  @@map("grammar_lesson")
}

model PhoneticsCourse {
  id              Int     @id @default(autoincrement())
  title           String  @db.VarChar(255)
  materialLanguage String @db.VarChar(2) @default("ru")
  metaKeywords    String? @db.Text
  metaDescription String? @db.Text
  languageId      Int     @unique
  language        Language @relation(fields: [languageId], references: [id])
  lessons         PhoneticsLesson[]

  @@map("phonetics_course")
}

model PhoneticsLesson {
  id              Int     @id @default(autoincrement())
  title           String  @db.VarChar(255)
  courseId        Int
  order           Int
  metaKeywords    String? @db.Text
  metaDescription String? @db.Text

  course PhoneticsCourse @relation(fields: [courseId], references: [id])

  @@index([courseId, order])

  @@map("phonetics_lesson")
}

model SongsCourse {
  id               Int     @id @default(autoincrement())
  title            String  @db.VarChar(255)
  materialLanguage String  @db.VarChar(2) @default("ru")
  languageId       Int     @unique
  language         Language @relation(fields: [languageId], references: [id])
  lessons          SongsLesson[]

  @@map("songs_course")
}

model SongsLesson {
  id       Int    @id @default(autoincrement())
  title    String @db.VarChar(255)
  courseId Int
  order    Int

  course SongsCourse @relation(fields: [courseId], references: [id])

  @@index([courseId, order])

  @@map("songs_lesson")
}

model SevenCourse {
  id                Int      @id @default(autoincrement())
  legacyId          Int      @unique
  title             String   @db.VarChar(255)
  materialLanguage  String   @db.VarChar(2) @default("ru")
  metaKeywords      String?  @db.Text
  metaDescription   String?  @db.Text
  languageId        Int
  language          Language @relation(fields: [languageId], references: [id])
  appPackage        String?  @db.VarChar(255)
  materialsChanged  DateTime @db.Date
  metadata          Json     @default("{}")
  lessons           SevenLesson[]

  @@unique([languageId, materialLanguage])
  @@index([materialLanguage])

  @@map("seven_course")
}

model SevenLesson {
  id              Int      @id @default(autoincrement())
  legacyId        Int      @unique
  title           String   @db.VarChar(255)
  courseId        Int
  order           Int
  prefix          String?  @db.VarChar(255)
  template        String   @db.VarChar(255)
  bodyHtml        String   @default("") @db.Text
  metaKeywords    String?  @db.Text
  metaDescription String?  @db.Text
  metadata        Json     @default("{}")

  course    SevenCourse @relation(fields: [courseId], references: [id])
  exercises SevenExercise[]

  @@unique([courseId, order])
  @@index([courseId, order])

  @@map("seven_lesson")
}

model SevenExercise {
  id             Int     @id @default(autoincrement())
  lessonId       Int
  order          Int
  title          String  @db.VarChar(255)
  legacyKey      String  @unique @db.VarChar(512)
  exerciseTemplate String @db.VarChar(255)
  answerTemplate   String? @db.VarChar(255)
  exerciseHtml   String  @default("") @db.Text
  answerHtml     String? @db.Text
  metadata       Json    @default("{}")

  lesson SevenLesson @relation(fields: [lessonId], references: [id])

  @@unique([lessonId, order])
  @@index([lessonId, order])

  @@map("seven_exercise")
}

model Word {
  id            Int     @id @default(autoincrement())
  word          String  @db.VarChar(255)
  transcription String? @db.VarChar(255)
  translation   String? @db.Text
  languageId    Int

  language Language @relation(fields: [languageId], references: [id])
  themes   WordThemeRelation[]

  @@unique([word, languageId, translation])
  @@index([word])

  @@map("word")
}

model WordTheme {
  id          Int     @id @default(autoincrement())
  name        String  @db.VarChar(255)
  moduleClass String  @db.VarChar(255) @default("")
  order       Int     @default(0)

  words WordThemeRelation[]

  @@index([order])
  @@index([name])

  @@map("word_theme")
}

model WordThemeRelation {
  id      Int @id @default(autoincrement())
  wordId  Int
  themeId Int
  order   Int @default(0)

  word  Word      @relation(fields: [wordId], references: [id])
  theme WordTheme @relation(fields: [themeId], references: [id])

  @@unique([wordId, themeId, order])
  @@index([themeId, order])

  @@map("word_theme_relation")
}

model DrillTopic {
  id               Int      @id @default(autoincrement())
  slug             String   @db.VarChar(255)
  languageId       Int
  materialLanguage String   @db.VarChar(2)
  title            String   @db.VarChar(255)
  level            String?  @db.VarChar(4)
  grammarLessonId  Int?
  parentTopicId    Int?
  isNew            Boolean  @default(false)
  createdAt        DateTime @default(now())

  language Language    @relation(fields: [languageId], references: [id])
  items    DrillItem[]

  @@unique([languageId, materialLanguage, slug])
  @@index([languageId, materialLanguage])

  @@map("drill_topic")
}

model DrillItem {
  id                   Int      @id @default(autoincrement())
  languageId           Int
  materialLanguage     String   @db.VarChar(2)
  topicId              Int?
  level                String?  @db.VarChar(4)
  template             String   @db.Text
  blanks               Json
  plainText            String   @db.Text
  hint                 String?  @db.Text
  sourceType           String   @db.VarChar(16)
  sourceRef            String?  @db.VarChar(255)
  courseKey            String?  @db.VarChar(255)
  lessonOrder          Int?
  unknownWords         Json     @default("[]")
  hash                 String   @unique @db.VarChar(64)
  status               String   @default("ACTIVE") @db.VarChar(16)
  timesShown           Int      @default(0)
  timesCorrectFirstTry Int      @default(0)
  createdAt            DateTime @default(now())

  language  Language            @relation(fields: [languageId], references: [id])
  topic     DrillTopic?         @relation(fields: [topicId], references: [id])
  revisions DrillItemRevision[]
  setItems  DrillSetItem[]

  @@index([languageId, materialLanguage, topicId, status])
  @@index([courseKey, lessonOrder])

  @@map("drill_item")
}

model DrillItemRevision {
  id        Int      @id @default(autoincrement())
  itemId    Int
  template  String   @db.Text
  blanks    Json
  hint      String?  @db.Text
  reason    String   @db.VarChar(32)
  createdAt DateTime @default(now())

  item DrillItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, createdAt])

  @@map("drill_item_revision")
}

// Materialized "known by lesson N" baseline that Track D's 80/20 rule checks
// against. `source` is a string, not an enum, so a future data source can
// land without a migration.
//
// As of 2026-07-30, only 'ITEM' and 'LESSON_BODY' rows are ever written —
// 'THEME' is kept as an allowed value because Word/WordTheme/WordThemeRelation
// are the intended source for it but currently hold 0 rows in production (the
// curated per-module wordlist was never imported). This is NOT a bug in the
// builder; see scripts/build-course-vocabulary.ts.
model CourseVocabulary {
  id          Int      @id @default(autoincrement())
  courseKey   String   @db.VarChar(255)
  languageId  Int
  lessonOrder Int
  word        String   @db.VarChar(255)
  lemma       String?  @db.VarChar(255)
  translation String?  @db.Text
  // 'THEME' | 'ITEM' | 'LESSON_BODY' — see VocabularySource in src/drills/contracts.ts.
  source      String   @db.VarChar(16)
  createdAt   DateTime @default(now())

  language Language @relation(fields: [languageId], references: [id])

  @@unique([courseKey, languageId, word, source])
  @@index([courseKey, languageId, lessonOrder])

  @@map("course_vocabulary")
}

// A reusable, reviewable collection of drill items — the unit of assignment
// and of reuse. Sets are shared across teachers by default; `visibility` is
// the opt-out, not the norm.
//
// `searchText` is the concatenated plainText of the set's items, carried on
// the row so library search is one indexed lookup rather than a join and a
// scan. It is GIN tsvector indexed by hand in the migration SQL — Prisma
// cannot express that index, so it does not appear here.
//
// `avgFirstTryAccuracy` is deliberately NOT part of popularityScore (a hard
// set is not a bad set) and is never shown to a teacher; it exists only as an
// internal difficulty signal for item selection. See spec 8.2.
model DrillSet {
  uuid                String    @id @db.Uuid
  title               String    @db.VarChar(255)
  languageId          Int
  materialLanguage    String    @db.VarChar(2)
  level               String?   @db.VarChar(4)
  topicSlugs          String[]
  courseKey           String?   @db.VarChar(255)
  lessonOrder         Int?
  // AI | BANK | MIXED | TEACHER — see DrillSetOrigin in src/drills/contracts.ts.
  origin              String    @db.VarChar(16)
  // GENERATING | VALIDATING | PENDING_REVIEW | APPROVED — see DrillSetReviewState.
  reviewState         String    @db.VarChar(16)
  createdByTeacherId  Int?
  // The teacher's original free-text request, kept verbatim for regeneration.
  instructions        String?   @db.Text
  // SHARED | PRIVATE
  visibility          String    @default("SHARED") @db.VarChar(8)
  searchText          String    @db.Text
  knownWordRatio      Float?
  timesAssigned       Int       @default(0)
  timesSelfSelected   Int       @default(0)
  teacherUpvotes      Int       @default(0)
  studentUpvotes      Int       @default(0)
  avgFirstTryAccuracy Float?
  popularityScore     Float     @default(0)
  createdAt           DateTime  @default(now())
  approvedAt          DateTime?

  language Language         @relation(fields: [languageId], references: [id])
  items    DrillSetItem[]
  ratings  DrillSetRating[]

  @@index([languageId, materialLanguage, reviewState])
  @@index([courseKey, lessonOrder])
  @@index([popularityScore])

  @@map("drill_set")
}

model DrillSetItem {
  id               Int       @id @default(autoincrement())
  setUuid          String    @db.Uuid
  itemId           Int
  order            Int
  // PENDING | PASS | WARN | FAIL | OVERRIDDEN — see ValidationState.
  validationState  String    @default("PENDING") @db.VarChar(16)
  validationIssues Json      @default("[]")
  validatedAt      DateTime?
  validatorVersion String?   @db.VarChar(32)

  set  DrillSet  @relation(fields: [setUuid], references: [uuid], onDelete: Cascade)
  item DrillItem @relation(fields: [itemId], references: [id])

  @@unique([setUuid, order])
  @@index([itemId])

  @@map("drill_set_item")
}

// One vote per rater per set, changeable — hence the unique key and the
// upsert in SetsService.recordRating.
model DrillSetRating {
  id        Int      @id @default(autoincrement())
  setUuid   String   @db.Uuid
  // TEACHER | STUDENT
  raterType String   @db.VarChar(8)
  raterId   Int
  // +1 | -1
  value     Int
  comment   String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  set DrillSet @relation(fields: [setUuid], references: [uuid], onDelete: Cascade)

  @@unique([setUuid, raterType, raterId])

  @@map("drill_set_rating")
}
