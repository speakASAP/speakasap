// Phase 3 Wave 3 — core education tables (legacy `education` app). Maps to Django defaults.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Group {
  uuid           String          @id @map("uuid") @db.Uuid
  title          String          @db.VarChar(255)
  createdAt      DateTime        @default(now()) @map("created")
  groupStudents  GroupStudent[]
  studentCourses StudentCourse[]

  @@map("education_group")
}

model GroupStudent {
  id        Int    @id @default(autoincrement())
  groupUuid String @map("group_id") @db.Uuid
  studentId Int    @map("student_id")
  group     Group  @relation(fields: [groupUuid], references: [uuid], onDelete: Cascade)

  @@unique([groupUuid, studentId])
  @@index([studentId])
  @@map("education_group_students")
}

model StudentCourse {
  uuid               String    @id @map("uuid") @db.Uuid
  courseClass        String    @map("course_class") @db.VarChar(255)
  courseDisplayTitle String    @default("") @map("course_display_title") @db.VarChar(255)
  createdAt          DateTime  @default(now()) @map("created")
  openStrategyClass  String    @map("open_strategy_class") @db.VarChar(255)
  groupUuid          String    @map("group_id") @db.Uuid
  previousUuid       String?   @unique @map("previous_id") @db.Uuid
  isFinished         Boolean   @default(false) @map("is_finished")
  endDate            DateTime? @map("end_date")
  isNew              Boolean   @default(true) @map("is_new")
  isPaused           Boolean   @default(false) @map("is_paused")
  autoPause          Boolean   @default(false) @map("auto_pause")
  pauseDate          DateTime? @map("pause_date")
  group              Group     @relation(fields: [groupUuid], references: [uuid], onDelete: Restrict)
  previous           StudentCourse? @relation("StudentCoursePrevNext", fields: [previousUuid], references: [uuid])
  next               StudentCourse? @relation("StudentCoursePrevNext")
  lessons            Lesson[]

  @@index([groupUuid])
  @@map("education_studentcourse")
}

model Lesson {
  uuid                         String        @id @map("uuid") @db.Uuid
  order                        Int
  teacherId                    Int?          @map("teacher_id")
  start                        DateTime?
  lessonChangeStartCount       Int           @default(0) @map("lesson_change_start_count")
  isFinished                   Boolean       @default(false) @map("is_finished")
  studentCourseUuid            String        @map("student_course_id") @db.Uuid
  moduleClass                  String        @map("module_class") @db.VarChar(255)
  needsTeacher                 Boolean       @default(false) @map("needs_teacher")
  assignTeacherAutomatically   Boolean       @default(false) @map("assign_teacher_automatically")
  recommendation               String        @default("") @db.Text
  toManager                    String        @default("") @map("to_manager") @db.Text
  studentCourse                StudentCourse @relation(fields: [studentCourseUuid], references: [uuid], onDelete: Cascade)
  homeworks                    Homework[]
  lessonRecord                 LessonRecord?
  studentAccesses              StudentAccess[]
  drillAssignments             DrillAssignment[]

  @@index([studentCourseUuid])
  @@map("education_lesson")
}

model StudentAccess {
  uuid      String  @id @map("uuid") @db.Uuid
  lessonUuid String @map("lesson_id") @db.Uuid
  studentId Int    @map("student_id")
  isPaid    Boolean @default(false) @map("is_paid")
  lesson    Lesson @relation(fields: [lessonUuid], references: [uuid], onDelete: Cascade)

  @@unique([lessonUuid, studentId])
  @@index([studentId])
  @@map("education_studentaccess")
}

model Homework {
  uuid           String  @id @map("uuid") @db.Uuid
  lessonUuid     String  @map("lesson_id") @db.Uuid
  studentId      Int     @map("student_id")
  contentStudent String  @default("") @map("content_student") @db.Text
  contentTeacher String  @default("") @map("content_teacher") @db.Text
  ready          Boolean @default(false)
  comment        String? @db.Text
  checked        Boolean @default(false)
  lesson         Lesson  @relation(fields: [lessonUuid], references: [uuid], onDelete: Cascade)

  @@unique([lessonUuid, studentId])
  @@index([studentId])
  @@map("education_homework")
}

model LessonRecord {
  uuid              String             @id @map("uuid") @db.Uuid
  lessonUuid        String             @unique @map("lesson_id") @db.Uuid
  recordKey         String?            @map("record") @db.Text
  processed         Boolean            @default(false)
  recordUnavailable String             @default("") @map("record_unavailable") @db.Text
  durationSeconds   Int?               @map("duration_seconds")
  parts             Json               @default("[]")
  createdAt         DateTime           @default(now()) @map("created")
  updatedAt         DateTime           @updatedAt @map("updated")
  lesson            Lesson             @relation(fields: [lessonUuid], references: [uuid], onDelete: Cascade)
  recordParts       LessonRecordPart[]

  @@index([lessonUuid])
  @@map("education_lessonrecord")
}

model LessonRecordPart {
  uuid             String       @id @map("uuid") @db.Uuid
  lessonRecordUuid String       @map("lesson_record_id") @db.Uuid
  partKey          String       @map("part_file") @db.Text
  createdAt        DateTime     @default(now()) @map("created")
  lessonRecord     LessonRecord @relation(fields: [lessonRecordUuid], references: [uuid], onDelete: Cascade)

  @@index([lessonRecordUuid])
  @@map("education_lessonrecordpart")
}

model DrillAssignment {
  uuid               String    @id @db.Uuid
  setUuid            String    @map("set_uuid") @db.Uuid
  studentId          Int       @map("student_id")
  teacherId          Int?      @map("teacher_id")
  origin             String    @db.VarChar(8)
  studentCourseUuid  String?   @map("student_course_uuid") @db.Uuid
  lessonUuid         String?   @map("lesson_uuid") @db.Uuid
  batchUuid          String?   @map("batch_uuid") @db.Uuid
  title              String    @db.VarChar(255)
  languageCode       String    @map("language_code") @db.VarChar(8)
  materialLanguage   String    @map("material_language") @db.VarChar(2)
  status             String    @db.VarChar(16)
  dueAt              DateTime? @map("due_at")
  resourceLinks      Json      @default("[]") @map("resource_links")
  generationMeta     Json      @default("{}") @map("generation_meta")
  generationProgress Json      @default("{}") @map("generation_progress")
  firstTryAccuracy   Float?    @map("first_try_accuracy")
  createdAt          DateTime  @default(now()) @map("created_at")
  assignedAt         DateTime? @map("assigned_at")
  startedAt          DateTime? @map("started_at")
  completedAt        DateTime? @map("completed_at")

  lesson Lesson?               @relation(fields: [lessonUuid], references: [uuid], onDelete: SetNull)
  items  DrillAssignmentItem[]

  @@index([studentId, status])
  @@index([teacherId, status])
  @@index([lessonUuid])
  @@index([setUuid])
  @@map("drill_assignment")
}

model DrillAssignmentItem {
  uuid           String  @id @db.Uuid
  assignmentUuid String  @map("assignment_uuid") @db.Uuid
  order          Int
  sourceItemId   Int?    @map("source_item_id")
  template       String  @db.Text
  blanks         Json
  hint           String? @db.Text
  topicSlug      String? @map("topic_slug") @db.VarChar(255)

  assignment DrillAssignment @relation(fields: [assignmentUuid], references: [uuid], onDelete: Cascade)

  @@unique([assignmentUuid, order])
  @@map("drill_assignment_item")
}

model DrillAttempt {
  uuid           String   @id @db.Uuid
  assignmentUuid String   @map("assignment_uuid") @db.Uuid
  itemUuid       String   @map("item_uuid") @db.Uuid
  blankIndex     Int      @map("blank_index")
  submittedValue String   @map("submitted_value") @db.Text
  isCorrect      Boolean  @map("is_correct")
  attemptNo      Int      @map("attempt_no")
  revealed       Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([assignmentUuid, itemUuid])
  @@map("drill_attempt")
}

model DrillAssignmentBatch {
  uuid         String   @id @db.Uuid
  teacherId    Int      @map("teacher_id")
  instructions String   @db.Text
  filter       Json
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("drill_assignment_batch")
}
