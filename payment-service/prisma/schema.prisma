generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  draft
  awaiting_payment
  paid
  canceled
  expired
}

enum DiscountType {
  PERCENT
  FIXED
}

enum SubscriptionBillingStatus {
  active
  canceled
  past_due
}

model Order {
  id           String      @id @default(uuid())
  userId       String      @map("user_id")
  title        String
  priceMinor   Int         @map("price_minor")
  currency     String      @default("EUR")
  paid         Boolean     @default(false)
  status       OrderStatus
  productId    String?     @map("product_id")
  data         Json        @default("{}")
  tillDate     DateTime?   @map("till_date") @db.Date
  comment      String?
  sticky       Boolean     @default(false)
  discountable Boolean     @default(true)
  deletable    Boolean     @default(true)
  trashedAt    DateTime?   @map("trashed_at")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  paymentAttempts PaymentAttempt[]
  discountOrder   DiscountOrder?
  invoices        Invoice[]
  subscriptions   Subscription[]

  @@index([userId, createdAt(sort: Desc)])
  @@map("orders")
}

model PaymentAttempt {
  id                String    @id @default(uuid())
  orderId           String    @map("order_id")
  amountMinor       Int       @map("amount_minor")
  paidAt            DateTime? @map("paid_at")
  publicUuid        String    @unique @default(uuid()) @map("public_uuid")
  providerPaymentId String?   @unique @map("provider_payment_id")
  method            String
  status            String    @default("pending")
  providerPayload   Json?     @map("provider_payload")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("payment_attempts")
}

model DiscountTemplate {
  code           String       @id
  singleUser     Boolean      @default(false) @map("single_user")
  enabled        Boolean      @default(true)
  discount       Decimal      @db.Decimal(12, 4)
  discountType   DiscountType @map("discount_type")
  validTill      DateTime?    @map("valid_till")
  comment        String?
  permanent      Boolean      @default(false)
  courseDiscount Boolean      @default(false) @map("course_discount")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  products      DiscountProduct[]
  discountOrders DiscountOrder[]

  @@map("discount_templates")
}

model DiscountProduct {
  templateCode String @map("template_code")
  productId    String @map("product_id")

  template DiscountTemplate @relation(fields: [templateCode], references: [code], onDelete: Cascade)

  @@id([templateCode, productId])
  @@map("discount_products")
}

model DiscountOrder {
  orderId              String @id @map("order_id")
  discountTemplateCode String @map("discount_template_code")

  order    Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  template DiscountTemplate @relation(fields: [discountTemplateCode], references: [code], onDelete: Restrict)

  @@map("discount_orders")
}

model Subscription {
  id                             String                     @id @default(uuid())
  userId                         String                     @map("user_id")
  status                         SubscriptionBillingStatus
  currentPeriodEnd               DateTime?                  @map("current_period_end")
  paymentsMicroserviceCustomerId String?                   @map("payments_ms_customer_id")
  orderId                        String?                    @map("order_id")
  metadata                       Json                       @default("{}")
  createdAt                      DateTime                   @default(now()) @map("created_at")
  updatedAt                      DateTime                   @updatedAt @map("updated_at")

  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@map("subscriptions")
}

model Invoice {
  id          String    @id @default(uuid())
  orderId     String    @map("order_id")
  userId      String    @map("user_id")
  number      String?
  received    Boolean   @default(false)
  amountMinor Int       @map("amount_minor")
  currency    String    @default("EUR")
  metadata    Json      @default("{}")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("invoices")
}

model WebhookEvent {
  id         String   @id @default(uuid())
  provider   String   @default("payments-ms")
  eventId    String   @unique @map("event_id")
  paymentId  String   @map("payment_id")
  orderId    String?  @map("order_id")
  status     String
  amountMinor Int?    @map("amount_minor")
  currency   String?
  occurredAt DateTime @map("occurred_at")
  rawRef     String?  @map("raw_ref")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([provider, paymentId, status, occurredAt])
  @@map("webhook_events")
}

model IdempotencyRecord {
  id           String   @id @default(uuid())
  key          String   @unique
  bodyHash     String   @map("body_hash")
  responseJson Json     @map("response_json")
  httpStatus   Int      @map("http_status")
  createdAt    DateTime @default(now()) @map("created_at")
  expiresAt    DateTime @map("expires_at")

  @@index([expiresAt])
  @@map("idempotency_records")
}
