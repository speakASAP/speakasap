# ============================================
# Application
# ============================================
NODE_ENV=
DOMAIN=
SERVICE_NAME=
PORT=

# ============================================
# Database (Phase 3 target: speakasap_user_db)
# ============================================
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
DATABASE_URL=

# ============================================
# Auth microservice (JWT validation — consumer only)
# ============================================
AUTH_SERVICE_URL=
AUTH_SERVICE_TIMEOUT=

# ============================================
# Logging microservice
# ============================================
LOGGING_SERVICE_URL=
LOGGING_SERVICE_API_PATH=
LOGGING_SERVICE_TIMEOUT=

# ============================================
# API pagination (list endpoints; max 30)
# ============================================
DEFAULT_PAGE_SIZE=
MAX_PAGE_SIZE=

# ============================================
# Internal migration / service routes
# ============================================
# Send this value in the X-Internal-Token header on /api/v1/internal/*
INTERNAL_API_TOKEN=

# ============================================
# Media URLs (avatars)
# ============================================
MATERIALS_BASE_URL=

# ============================================
# Optional
# ============================================
LOG_LEVEL=
# If you use a format with spaces, quote the whole value so `set -a && . ./.env` works, e.g.:
# LOG_TIMESTAMP_FORMAT="YYYY-MM-DD HH:mm:ss"
LOG_TIMESTAMP_FORMAT=
NGINX_NETWORK_NAME=
